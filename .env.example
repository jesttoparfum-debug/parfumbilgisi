# Bu dosyayı .env.local olarak kopyala ve Supabase > Project Settings > API'den doldur.
# Vercel'de: Project > Settings > Environment Variables bölümüne aynı ikisini ekle.
# NEXT_PUBLIC_ öneki YOK: anahtar tarayıcıya hiç gönderilmez, sadece sunucuda kullanılır.
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...

# Asla buraya service_role anahtarı koyma.

# Görseller Cloudflare R2'ye taşındıktan SONRA tanımla (öncesinde boş bırak, görseller Supabase'den gelir):
# IMAGE_BASE_URL=https://gorsel.parfumbilgisi.com
